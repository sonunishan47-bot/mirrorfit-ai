# Copy to apps/web/.env.local and fill in.
# Never commit a filled-in copy: .env.local is gitignored.

# ---------------------------------------------------------------------------
# Public - shipped to the browser. Nothing secret may go in this section.
# ---------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL="https://your-project-ref.supabase.co"
# Publishable key (sb_publishable_...). Safe to expose; RLS governs access.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY="sb_publishable_xxxxxxxxxxxxxxxxxxxxxxxx"

# ---------------------------------------------------------------------------
# Server only - must never reach a client bundle.
# Read exclusively through apps/web/src/env/server.ts, which is guarded by the
# `server-only` package.
# ---------------------------------------------------------------------------
# Secret key (sb_secret_...). Bypasses row level security entirely.
# Get it from: Supabase dashboard -> Project Settings -> API keys.
SUPABASE_SECRET_KEY=""

# Optional. Not read by the browser. Absent means realistic try-on stays
# NOT CONNECTED and the live 2D overlay keeps working.
# WORKER_SECRET must be at least 16 characters and must match the GPU worker.
# WORKER_ENDPOINT_URL is the private model server (http://127.0.0.1 on the GPU
# machine, or your own server). RUNPOD_ENDPOINT_URL is only a legacy alias.
# MODEL_NAME selects a capability profile. Known research checkpoints
# (catvton, idm-vton, ootdiffusion, catv2ton, qwen-image-2.1) are refused
# unless MODEL_ALLOW_NONCOMMERCIAL=1. That flag does not make them commercial.
# WORKER_SECRET=""
# WORKER_ENDPOINT_URL=""
# RUNPOD_ENDPOINT_URL=""
# MODEL_PROVIDER="private"
# MODEL_NAME=""
# MODEL_VERSION=""
# MODEL_ALLOW_NONCOMMERCIAL=""
# MIRRORFIT_APP_ORIGIN="https://your-public-app-host"
# Plan gate for still jobs: shop (no GPU quota), brand, or enterprise.
# MIRRORFIT_PLAN="shop"

