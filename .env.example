# Copy to apps/web/.env.local and fill in.
# Never commit a filled-in copy: .env.local is gitignored.

# ---------------------------------------------------------------------------
# Public - shipped to the browser. Nothing secret may go in this section.
# ---------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL="https://your-project-ref.supabase.co"
# Publishable key (sb_publishable_...). Safe to expose; RLS governs access.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY="sb_publishable_xxxxxxxxxxxxxxxxxxxxxxxx"

# ---------------------------------------------------------------------------
# Server only - must never reach a client bundle.
# Read exclusively through apps/web/src/env/server.ts, which is guarded by the
# `server-only` package.
# ---------------------------------------------------------------------------
# Secret key (sb_secret_...). Bypasses row level security entirely.
# Get it from: Supabase dashboard -> Project Settings -> API keys.
SUPABASE_SECRET_KEY=""

# Optional. Not read by the browser. Absent means the realistic try-on
# provider stays NOT CONNECTED and the live 2D overlay keeps working.
# WORKER_SECRET must be at least 16 characters and must match the pod worker.
# RUNPOD_ENDPOINT_URL is the private inference URL (often http://127.0.0.1 on
# the pod). Do not point the browser at it. Leave both empty until a model
# is actually installed.
# WORKER_SECRET=""
# RUNPOD_ENDPOINT_URL=""
# MIRRORFIT_APP_ORIGIN="https://your-public-app-host"

